 * the staged copies — the source of truth is the template in
 * examples/_browser-shell/mount.ts.tmpl.
 *
 * [LAW:one-source-of-truth] One template; one substituted import path per
 * demo. The HTML stays uniform; only the wire module changes.
 *
 * [LAW:dataflow-not-control-flow] This mount does not branch on which demo
 * it is bootstrapping — the wire module is a value substituted at build
 * time, the rest of the boot sequence is identical for every demo.
 *
 * [LAW:types-are-the-program] The `Terminal` global declared here is the
 * minimum surface every wire's `mount(terminal: XtermTerminal)` expects:
 * cols/rows, write, onData, onResize, plus the DOM-mount helpers we call
 * locally (open, focus). Declaring the full shape lets TypeScript match
 * structurally — no `as unknown as` cast needed at the boundary.
 */
import mount from "__DEMO_WIRE__";

interface XtermDisposable {
  dispose(): void;
}

declare const Terminal: new (opts: Record<string, unknown>) => {
  readonly cols: number;
  readonly rows: number;
  write(data: Uint8Array | string): void;
  onData(handler: (data: string) => void): XtermDisposable;
  onResize(handler: (size: { cols: number; rows: number }) => void): XtermDisposable;
  open(el: HTMLElement): void;
  focus(): void;
};

// [LAW:no-defensive-null-guards] exception: trust boundary — DOM lookup
// is genuinely optional; null check throws a precise error if the shell
// HTML is missing its #status / #term elements.
function requireEl<T extends HTMLElement>(id: string): T {
  const el = document.getElementById(id);
  if (el === null) {
    throw new Error(
      `rich-js mount: missing required element #${id} in the page shell.`,
    );
  }
  return el as T;
}

const statusEl = requireEl<HTMLSpanElement>("status");
const setStatus = (msg: string, cls?: string): void => {
  statusEl.textContent = msg;
  statusEl.className = cls ?? "";
};

try {
  const term = new Terminal({
    cols: 100,
    rows: 30,
    cursorBlink: true,
    theme: { background: "#1e1e1e" },
  });
  term.open(requireEl<HTMLDivElement>("term"));
  term.focus();
  // No cast: the local `Terminal` instance shape matches the wire's
  // `XtermTerminal` parameter type structurally.
  const handle = mount(term);
  (window as unknown as { __handle: unknown }).__handle = handle;
  setStatus("ready · first frame rendered", "ok");
} catch (err) {
  const e = err as Error | undefined;
  setStatus("boot error: " + (e?.message ?? String(err)), "err");
  // eslint-disable-next-line no-console
  console.error(err);
}
