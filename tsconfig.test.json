/*
 * [LAW:verifiable-goals] Vitest transpiles through esbuild and never
 * type-checks, so without this config the test suite — the one region that
 * models real caller usage — is inspected by no compiler at all, and a green
 * run stops being evidence that the tested API still exists in that shape.
 *
 * [LAW:single-enforcer] The root config owns every compiler option; this file
 * only widens the inspected region to `test/` and turns emit off. The two
 * overrides below are forced: the root pins `rootDir` to `src`, which would
 * reject `test/` before type-checking it, and emitting test declarations into
 * `dist/` is not a thing anyone wants.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // A demo under `examples/` imports the library by its published names,
    // as its card runs it, and a test reaches those files: each name is the
    // `src/` file it publishes, as every other in-repo reader resolves it
    // (`PUBLISHED_PATHS` in scripts/repo-facts.ts). Node would self-resolve
    // them to `dist/`, which lint runs before anything builds.
    // test/seam/test-resolution.test.ts holds this list to that one.
    "paths": {
      "@promptctl/rich-js": ["./src/index.ts"],
      "@promptctl/rich-js/themes/data": ["./src/themes/data/index.ts"],
      "@promptctl/rich-js/themes/registry": ["./src/themes/registry.ts"],
      "@promptctl/rich-js/host": ["./src/host/index.ts"],
      "@promptctl/rich-js/widgets": ["./src/widgets/index.ts"],
      "@promptctl/rich-js/template-bindings": ["./src/template-bindings/index.ts"],
      "@promptctl/rich-js/node/save": ["./src/node/save.ts"],
      "@promptctl/rich-js/node/prompt": ["./src/node/prompt.ts"],
      "@promptctl/rich-js/node/traceback": ["./src/node/traceback.ts"],
      "@promptctl/rich-js/node/terminal-host": ["./src/node/terminal-host.ts"]
    }
  },
  "include": ["test"]
}
