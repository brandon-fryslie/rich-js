{
  "name": "@promptctl/rich-js",
  "version": "0.19.0",
  "description": "Rich text and beautiful formatting in the terminal — a TypeScript port of Python's Rich",
  "repository": {
    "type": "git",
    "url": "https://github.com/brandon-fryslie/rich-js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes/data": {
      "types": "./dist/themes/data/index.d.ts",
      "import": "./dist/themes/data/index.js"
    },
    "./themes/registry": {
      "types": "./dist/themes/registry.d.ts",
      "import": "./dist/themes/registry.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js"
    },
    "./template-bindings": {
      "types": "./dist/template-bindings/index.d.ts",
      "import": "./dist/template-bindings/index.js"
    },
    "./node/save": {
      "types": "./dist/node/save.d.ts",
      "import": "./dist/node/save.js"
    },
    "./node/prompt": {
      "types": "./dist/node/prompt.d.ts",
      "import": "./dist/node/prompt.js"
    },
    "./node/traceback": {
      "types": "./dist/node/traceback.d.ts",
      "import": "./dist/node/traceback.js"
    },
    "./node/terminal-host": {
      "types": "./dist/node/terminal-host.d.ts",
      "import": "./dist/node/terminal-host.js"
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/verify-release-tag.mjs && node scripts/verify-entry-points.mjs",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "docs:dev": "npm run demos:build && vitepress dev docs",
    "docs:build": "npm run demos:build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "demo": "node scripts/build-demos.ts && node dist-demo/examples/rich-explore/index.js",
    "demo:build": "node scripts/build-demos.ts",
    "sessions": "node scripts/build-demos.ts && node dist-demo/examples/claude-sessions/index.js",
    "strip": "node scripts/build-demos.ts && node dist-demo/examples/rich-strip/main.js",
    "effects-feel": "node scripts/build-demos.ts && node dist-demo/examples/effects-feel/index.js",
    "viewport": "node scripts/build-demos.ts && node dist-demo/examples/rich-viewport/index.js",
    "markup-plugins": "node scripts/build-demos.ts && node dist-demo/examples/rich-markup-plugins/index.js",
    "demo-inputs": "node scripts/build-demos.ts && node dist-demo/examples/rich-config/index.js",
    "demo:dropdown": "node scripts/build-demos.ts && node dist-demo/examples/dropdown-demo/main.js",
    "dash": "node scripts/build-demos.ts && node dist-demo/examples/rich-dash/index.js",
    "template-bindings": "node scripts/build-demos.ts && node dist-demo/examples/rich-template-bindings/index.js",
    "themes-and-color-studio": "node scripts/build-demos.ts && node dist-demo/examples/themes-and-color-studio/index.js",
    "harness:browser-host": "node scripts/build-demos.ts && echo 'Serving harness at http://localhost:8080/examples/browser-terminal-host-harness/' && npx --yes http-server@14.1.1 -p 8080 -c-1 -s .",
    "demos:build": "node scripts/build-demos.ts && vite build --config vite.config.demos.ts",
    "demos:preview": "vite preview --config vite.config.demos.ts",
    "test:demos": "playwright test"
  },
  "keywords": [
    "terminal",
    "rich",
    "ansi",
    "color",
    "table",
    "panel",
    "tree",
    "syntax",
    "markdown",
    "progress",
    "cli"
  ],
  "license": "MIT",
  "devEngines": {
    "runtime": { "name": "node", "version": "^22.18.0 || >=23.6.0", "onFail": "error" }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@promptctl/go-template-js": "^0.10.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@types/semver": "^7.8.0",
    "@xterm/headless": "^6.0.0",
    "markdown-it": "^14.3.2",
    "markdown-it-container": "^4.0.0",
    "mobx": "^7.0.3",
    "node-inspect-extracted": "^3.3.3",
    "semver": "^7.8.5",
    "strip-ansi": "^7.2.0",
    "sucrase": "^3.35.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "string-width": "^8.2.2"
  },
  "peerDependencies": {
    "@promptctl/go-template-js": "^0.10.0",
    "mobx": "^7.0.3"
  },
  "peerDependenciesMeta": {
    "@promptctl/go-template-js": {
      "optional": true
    },
    "mobx": {
      "optional": true
    }
  }
}
