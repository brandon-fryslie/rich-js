{
  "name": "@promptctl/rich-js",
  "version": "0.8.0",
  "description": "Rich text and beautiful formatting in the terminal — a TypeScript port of Python's Rich",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes/data": {
      "types": "./dist/themes/data/index.d.ts",
      "import": "./dist/themes/data/index.js"
    },
    "./themes/registry": {
      "types": "./dist/themes/registry.d.ts",
      "import": "./dist/themes/registry.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js"
    },
    "./template-bindings": {
      "types": "./dist/template-bindings/index.d.ts",
      "import": "./dist/template-bindings/index.js"
    },
    "./node/save": {
      "types": "./dist/node/save.d.ts",
      "import": "./dist/node/save.js"
    },
    "./node/prompt": {
      "types": "./dist/node/prompt.d.ts",
      "import": "./dist/node/prompt.js"
    },
    "./node/traceback": {
      "types": "./dist/node/traceback.d.ts",
      "import": "./dist/node/traceback.js"
    },
    "./node/terminal-host": {
      "types": "./dist/node/terminal-host.d.ts",
      "import": "./dist/node/terminal-host.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "docs:dev": "npm run demos:build && vitepress dev docs",
    "docs:build": "npm run demos:build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "demo": "tsc -p tsconfig.demo.json && node dist-demo/examples/rich-explore/index.js",
    "demo:build": "tsc -p tsconfig.demo.json",
    "sessions": "tsc -p tsconfig.demo.json && node dist-demo/examples/claude-sessions/index.js",
    "strip": "tsc -p tsconfig.demo.json && node dist-demo/examples/rich-strip/index.js",
    "markup-plugins": "tsc -p tsconfig.demo.json && node dist-demo/examples/rich-markup-plugins/index.js",
    "demo-inputs": "tsc -p tsconfig.demo.json && node dist-demo/examples/rich-config/index.js",
    "demo:dropdown": "tsc -p tsconfig.demo.json && node dist-demo/examples/dropdown-demo/index.js",
    "dash": "tsc -p tsconfig.demo.json && node dist-demo/examples/rich-dash/index.js",
    "template-bindings": "tsc -p tsconfig.demo.json && node dist-demo/examples/rich-template-bindings/index.js",
    "themes-and-color-studio": "tsc -p tsconfig.demo.json && node dist-demo/examples/themes-and-color-studio/index.js",
    "harness:browser-host": "tsc -p tsconfig.demo.json && echo 'Serving harness at http://localhost:8080/examples/browser-terminal-host-harness/' && npx --yes http-server@14.1.1 -p 8080 -c-1 -s .",
    "demos:build": "tsc -p tsconfig.demo.json && vite build --config vite.config.demos.ts",
    "demos:preview": "vite preview --config vite.config.demos.ts",
    "test:demos": "playwright test"
  },
  "keywords": [
    "terminal",
    "rich",
    "ansi",
    "color",
    "table",
    "panel",
    "tree",
    "syntax",
    "markdown",
    "progress",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.5.0",
    "strip-ansi": "^7.2.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@promptctl/go-template-js": "^0.5.0",
    "mobx": "^6.15.0",
    "string-width": "^8.2.0"
  }
}
