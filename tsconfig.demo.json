// Compiled by scripts/build-demos.ts, not by `tsc -p`: a demo imports the
// library by its published names, which that script maps onto `src/`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-demo",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    // `dist-demo/` sits beside `src/` and `examples/`, so its maps resolve.
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-demo", "test", "examples/effects-playground/page.ts", "examples/effects-playground/virtual.d.ts"]
}
