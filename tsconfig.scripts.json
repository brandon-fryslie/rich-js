{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [
    "vite.config.demos.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "docs/.vitepress/config.ts",
    "docs/demos/**/*.ts",
    "e2e/**/*.ts"
  ]
}
